      "layer_metadata": {
        "title_template": "Estimasi AGB Mangrove {status} {version}",
        "abstract_template": "{disclaimer} Model: {version} ({status}). Satuan: {unit}."
      },
      "disclaimer": "Versi beta: estimasi AGB ini belum divalidasi dengan data lapangan (ground truth). Nilainya berbasis statistik inventori provinsi dan indeks citra satelit, sehingga hanya cocok sebagai gambaran awal, bukan hasil pengukuran.",
      "metrics_display_allowed": false
