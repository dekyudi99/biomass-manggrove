        "sentinel2_composite": "median",
        "ndvi_bands": ["B8", "B4"],
        "sentinel1_collection": "COPERNICUS/S1_GRD",
        "sentinel1_instrument_mode": "IW",
        "sentinel1_polarizations": ["VV", "VH"],
        "sentinel1_orbit_filter": null,
        "sentinel1_speckle_filter": false,
        "sentinel1_composite": "median",
        "training_start_date_inclusive": "2026-03-01",
        "training_end_date_exclusive": "2026-04-01",
        "crs": "EPSG:32647",
