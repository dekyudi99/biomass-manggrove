# ==============================================================================
# Environment Configuration for Biomass Mangrove FastAPI Backend
# ==============================================================================

# Google Earth Engine (GEE) Configuration
EE_PROJECT_ID=your-google-cloud-project-id
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_KEY_FILE_PATH=/app/credentials/gee-key.json

# AstraGIS Server-to-Server (S2S) Gateway Integration
# - Lokal Docker: http://host.docker.internal:8001
# - Server/VPS Deployment: https://<domain-astragis> atau http://<ip-or-container>:8000
ASTRAGIS_API_URL=http://host.docker.internal:8001
ASTRAGIS_API_KEY=your_astragis_s2s_secret_key_here
ASTRAGIS_TIMEOUT=60

# GeoServer WMS URL (URL base GeoServer untuk browser client)
# - Lokal: http://localhost:8080/geoserver
# - Server/VPS Deployment: https://<domain-geoserver>/geoserver
GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# CORS Allowed Origins (pisahkan dengan koma jika ada domain publik frontend)
# Contoh: https://biomass.ikya.my.id,https://biomass-dev.ikya.my.id
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173
