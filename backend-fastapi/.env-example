# Environment configuration for FastAPI & Google Earth Engine

# Google Cloud / Earth Engine Project ID
EE_PROJECT_ID=your-google-cloud-project-id

# Opsi 1: Menggunakan Service Account (Sangat direkomendasikan untuk Server/Docker)
EE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
EE_KEY_FILE_PATH=/app/credentials/gee-key.json

# Opsi 2: Mode Development (Local User Auth)
# Jika dijalankan secara lokal tanpa Service Account, bisa gunakan ee.Authenticate() / gcloud auth
