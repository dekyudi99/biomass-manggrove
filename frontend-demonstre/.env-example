# ==============================================================================
# Environment Configuration Template for Biomass Mangrove Frontend
# Salin file ini menjadi .env lalu sesuaikan nilainya saat deployment.
# ==============================================================================

# URL API Backend Biomass (Spatial Gateway & Analytics)
# - Lokal: http://localhost:8000/api/spatial
# - Deployment: https://<domain-backend>/api/spatial
VITE_API_BASE_URL=http://localhost:8000/api/spatial

# URL GeoServer WMS (Opsional: override base URL WMS di sisi client browser)
# - Lokal: http://localhost:8080/geoserver
# - Deployment: https://<domain-geoserver>/geoserver
VITE_GEOSERVER_WMS_URL=http://localhost:8080/geoserver

# URL Reverse Geocoding API (OpenStreetMap Nominatim)
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# URL Layanan Lookup Definisi EPSG Proj4
VITE_EPSG_IO_URL=https://epsg.io

# URL Basemap Tile Providers
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TERRAIN_TILE_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png

# Default Bahasa Aplikasi (id, en, th)
VITE_DEFAULT_LANGUAGE=id
